# ── Groq (LLM Reasoning) ─────────────────────────────────────────
# Primary key for the ReAct agent (Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Secondary key for the chat assistant (Llama 3.1 8B) 
# You can use the same key as GROQ_API_KEY or a separate one
asistant_api_groq=your_groq_api_key_here

# ── Finnhub (Market Data) ────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Google Gemini ─────────────────────────────────────────────────
# For TTS (Text-to-Speech) narration of analysis
gemini_api_key=your_gemini_api_key_here

# For Gemini Live voice assistant (bidirectional audio)
gemini-3.1-flash-live-preview_api=your_gemini_api_key_here

# ── SEC EDGAR ─────────────────────────────────────────────────────
# Required by SEC: "AppName your@email.com"
SEC_USER_AGENT=MyApp myemail@example.com

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────
PORT=8000

# ── (Production only) ────────────────────────────────────────────
# FRONTEND_URL=https://your-app.vercel.app
